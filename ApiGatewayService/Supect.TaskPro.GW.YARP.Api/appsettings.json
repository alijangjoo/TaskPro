{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Gateway": {
    "Yarp": {
      "Routes": {
        "tasks-route": {
          "ClusterId": "tasks-cluster",
          "Match": {
            "Path": "/taskService/api/tasks/{**catch-all}"
          },
          "Transforms": [
            { "PathRemovePrefix": "/taskService" }
          ]
        }
      },
      "Clusters": {
        "tasks-cluster": {
          "Destinations": {
            "tasks-service": {
              "Address": "https://localhost:7108/"
            }
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}
